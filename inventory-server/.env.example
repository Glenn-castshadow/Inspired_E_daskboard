# Copy this to .env.docker and fill in real values
# The .env.docker file is gitignored — never commit your actual API key

# Required: shared secret — both Tauri apps must use the same key
API_KEY=replace-with-a-long-random-secret

# Optional overrides (defaults shown)
PORT=3456
DB_PATH=/data/inventory.db

# REQUIRED for Docker: the NAS/host LAN IP so QR codes encode a URL iPhones can reach.
# Without this, QR codes will use the container's internal IP and scanning won't work.
SCAN_BASE_URL=http://10.0.7.62:3456
